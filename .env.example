# ---- Banco (o Railway injeta automaticamente) ----
DATABASE_URL=

# ---- Acesso ----
APP_PASSWORD=troque-isto
ENCRYPTION_KEY=                 # 32 bytes em hex: openssl rand -hex 32

# ---- Provedores ----
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
BUFFER_ACCESS_TOKEN=

# Opcional: se vazio, o roteiro usa a OpenAI
ANTHROPIC_API_KEY=

# ---- Storage (bucket do Railway ou S3 compativel) ----
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# ---- Limites de custo, em USD ----
COST_DAILY_LIMIT_USD=5
COST_HARD_CAP_USD=50
LOW_CREDIT_THRESHOLD_VIDEOS=15

TZ=America/Sao_Paulo

# true = a fila e o cron rodam dentro do servico web (um slot so).
# Deixe vazio quando o worker tiver servico proprio.
WORKER_IN_PROCESS=
